---
const plans = [
  {
    name: 'Basic',
    price: '£30–40',
    for: 'The essentials, taken care of.',
    items: [
      'Website hosting',
      'SSL certificate',
      'Regular backups',
      'Security updates',
    ],
  },
  {
    name: 'Plus',
    price: '£60–80',
    for: 'More support, less to worry about.',
    pick: true,
    items: [
      'Everything in Basic',
      'Up to 1 hour of website edits each month',
      'Uptime monitoring',
    ],
  },
  {
    name: 'Growth',
    price: '£120–200',
    for: 'Ongoing improvements for growing businesses.',
    items: [
      'Everything in Plus',
      '2–3 hours of updates and improvements each month',
      'Monthly enquiry report',
      'Small SEO improvements',
    ],
  },
];
---

<section id="care" aria-labelledby="cp">
  <div class="section-head">
    <h2 id="cp">Website care plans</h2>
    <p>
      Your website deserves attention long after launch.
      My care plans take care of the technical details,
      keeping your website secure, maintained and performing
      as your business grows.
    </p>
    <p>
      Simple monthly pricing, no long-term contracts and
      just 30 days' notice if you decide to leave.
    </p>
  </div>

  <div class="tiers">
    {plans.map((plan) => (
      <article class:list={['tier', { pick: plan.pick }]}>
        {plan.pick && <span class="tag">Most popular</span>}

        <h3>{plan.name}</h3>

        <div class="price">{plan.price}<small> /month</small></div>

        <p class="for">{plan.for}</p>

        <ul>
          {plan.items.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>

        <button
          type="button"
          class="btn"
          data-open-contact
          data-interest={`${plan.name} care plan`}
          data-service="Website care and maintenance"
        >
          Choose {plan.name}
        </button>
      </article>
    ))}
  </div>
</section>
