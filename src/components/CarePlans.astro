
---
const plans = [
  {
    name: 'Basic',
    price: '£30–40',
    description: 'The essentials, taken care of.',
    features: [
      'Website hosting',
      'SSL certificate',
      'Regular backups',
      'Security updates',
    ],
  },
  {
    name: 'Plus',
    price: '£60–80',
    description: 'More support, less to worry about.',
    popular: true,
    features: [
      'Everything in Basic',
      'Up to 1 hour of website edits each month',
      'Uptime monitoring',
    ],
  },
  {
    name: 'Growth',
    price: '£120–200',
    description: 'Ongoing improvements for growing businesses.',
    features: [
      'Everything in Plus',
      '2–3 hours of website updates and improvements',
      'Monthly enquiry report',
      'Small SEO improvements',
    ],
  },
];
---

<section id="care" aria-labelledby="cp">
  <div class="section-head">
    <h2 id="cp">Website care plans</h2>
    <p>
      Your website deserves attention long after launch.
      My care plans take care of the technical details,
      keeping your website secure, maintained and performing
      as your business grows.
    </p>
    <p>
      Simple monthly pricing, no long-term contracts and
      just 30 days' notice if you decide to leave.
    </p>
  </div>

  <div class="care-tiers">
    {plans.map((plan) => (
      <article class:list={['tier', { pick: plan.popular }]}>
        {plan.popular && (
          <span class="tag">Most popular</span>
        )}

        <h3>{plan.name}</h3>

        <p class="price">
          {plan.price}
          <small> /month</small>
        </p>

        <p class="for">{plan.description}</p>

        <ul>
          {plan.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>

        <button
          type="button"
          class="btn care-choose"
          data-open-contact
          data-care-plan={plan.name}
        >
          Choose {plan.name}
        </button>
      </article>
    ))}
  </div>
</section>
