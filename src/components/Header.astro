
---
interface Props {
  logoAlt?: string;
}

const { logoAlt = 'Jevans Consulting' } = Astro.props;
const homeHref = Astro.url.pathname === '/' ? '' : '/';
---

<header class="nav">
  <a class="brand" href={homeHref + '#top'} aria-label={logoAlt + ' home'}>
    <img
      src="/jevans-logo.png"
      alt={logoAlt}
      class="brand-logo"
    />
  </a>

  <nav aria-label="Main navigation">
    <a href="/projects/">Previous projects</a>
    <a href={homeHref + '#packages'}>Packages</a>
    <a href={homeHref + '#care'}>Care plans</a>
    <a href={homeHref + '#process'}>Our process</a>
    <button type="button" class="btn" data-open-contact>
  Let's talk
</button>
  </nav>
</header>
