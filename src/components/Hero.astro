---
interface Props {
  audience: string;
}

const { audience } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div>
    <span class="hero-eyebrow">WEB DESIGN &amp; DIGITAL SUPPORT</span>

    <h1 id="hero-title">
      Your business deserves a better online presence.
    </h1>

    <p class="lede">
      Professional websites. Reliable support. Digital solutions
      that help your business grow.
    </p>

    <p>
      I help {audience} build a stronger presence online through
      thoughtfully designed websites and dependable digital support.
      Whether you need a brand-new website, improvements to an existing
      one or someone to take care of the technical details, I'm here
      to make things simpler.
    </p>

    <div class="actions">
      <a class="btn" href="#packages">Explore packages</a>
      <button type="button" class="btn ghost" data-open-contact>Let's talk</button>
    </div>
  </div>

  <!-- Example website (decorative, hidden from screen readers; the caption is visible) -->
  <figure class="showcase">
    <div class="browser" aria-hidden="true">
      <div class="browser-bar">
        <i></i><i></i><i></i>
        <span>yourbusiness.co.uk</span>
        <em class="browser-badge">Example design</em>
      </div>

      <div class="ex">
        <div class="ex-nav">
          <span class="ex-brand"><i></i>Brightwell Physio</span>
          <span>Treatments</span>
          <span>About</span>
          <span>Contact</span>
          <b class="ex-btn">Book now</b>
        </div>

        <div class="ex-hero">
          <div>
            <h4>Feel better, move better.</h4>
            <p>
              Friendly, expert physiotherapy for aches, injuries
              and everyday movement.
            </p>
            <div class="ex-actions">
              <span class="ex-btn">Book an appointment</span>
              <span class="ex-btn ghost">Our treatments</span>
            </div>
          </div>
          <div class="ex-photo"></div>
        </div>

        <div class="ex-cards">
          <span class="ex-card"><i></i>Back &amp; neck</span>
          <span class="ex-card"><i></i>Sports injuries</span>
          <span class="ex-card"><i></i>Rehabilitation</span>
        </div>

        <div class="ex-info">
          <span>Mon–Fri 8am–6pm</span>
          <span>Free parking</span>
          <span>Same-week appointments</span>
        </div>
      </div>
    </div>

    <figcaption>
      Example design: the kind of website I build for small - medium businesses.
    </figcaption>
  </figure>
</section>
