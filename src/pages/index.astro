---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Packages from '../components/Packages.astro';
import CarePlans from '../components/CarePlans.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import ContactModal from '../components/ContactModal.astro';
import Footer from '../components/Footer.astro';

// Replace these starter values with your final business details.
const name = 'Jevans Consulting';
const audience = 'small businesses';
const description = `Fast, simple websites for ${audience}, with clear pricing and monthly care plans.`;
---
<Layout title={`${name} | Websites for ${audience}`} description={description}>
  <div class="wrap">
    <Header />
    <main id="top">
      <Hero audience={audience} />
      <Services />
      <Packages />
      <CarePlans />
      <Process />
      <Contact />
    </main>
    <Footer name={name} />
  </div>
  <ContactModal />
</Layout>
